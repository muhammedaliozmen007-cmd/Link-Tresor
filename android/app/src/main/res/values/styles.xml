<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tresor" parent="android:Theme.Material">
        <item name="android:colorPrimary">#1E1F22</item>
        <item name="android:colorPrimaryDark">#1E1F22</item>
        <item name="android:colorAccent">#3B82F6</item>
        <item name="android:windowBackground">#1E1F22</item>
        <item name="android:navigationBarColor">#1E1F22</item>
        <item name="android:textColorPrimary">#E6E6E6</item>
        <item name="android:alertDialogTheme">@style/TresorDialog</item>
        <item name="android:actionMenuTextAppearance">@style/TresorMenuText</item>
    </style>

    <!-- „Claude rufen“ oben nicht in GROSSBUCHSTABEN -->
    <style name="TresorMenuText" parent="android:TextAppearance.Material.Widget.ActionBar.Menu">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TresorDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#3B82F6</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>
</resources>
